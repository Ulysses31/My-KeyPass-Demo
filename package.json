{
  "name": "my-key-pass-demo",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "start": "npm --prefix apps/web start",
    "build": "npm --prefix apps/web run build",
    "watch": "npm --prefix apps/web run watch",
    "start:web": "npm --prefix apps/web start",
    "start:desktop": "npm --prefix apps/desktop start",
    "start:api": "node api/index.js",
    "start:server": "node server.js",
    "start:static": "http-server ./data -p 4000 -c-1",
    "start:all": "concurrently -k -n server,api,desktop -c auto \"npm run start:server\" \"npm run start:api\" \"npm run start:desktop\""
  },
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "http-server": "^14.1.1",
    "rxjs": "~7.6.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.0",
    "@angular/cli": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "@types/node": "^22.10.2",
    "concurrently": "^9.2.0",
    "typescript": "~5.4.0"
  }
}
